# Copy this file to .env and fill in your own values. Never commit .env.

# Your Freshdesk helpdesk subdomain, e.g. "acme" for https://acme.freshdesk.com
FRESHDESK_DOMAIN=your-company

# Personal API key: Freshdesk -> profile picture -> Profile Settings -> "View API Key"
# Sent as HTTP Basic auth (API key as username, "X" as password), per Freshdesk docs.
FRESHDESK_API_KEY=dd

# Optional tuning (defaults shown)
# FRESHDESK_TIMEOUT_MS=10000
# FRESHDESK_MAX_RETRIES=3

# Optional: set to 1 to enable `npm run test:live` (read-only calls against the account above).
# Use a Freshdesk trial/demo account with fictional data only.
# FRESHDESK_LIVE_TEST=0
