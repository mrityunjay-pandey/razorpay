    {
      "name": "list_tickets",
      "title": "List Freshdesk tickets",
      "description": "List Freshdesk tickets page by page, newest first by default. Use this for 'recent tickets', or all tickets from one customer (requester_email or requester_id) or one company (company_id); use only one of those three per call. Freshdesk only returns tickets created in the last 30 days unless updated_since is set; pass updated_since to reach older tickets. To filter by status, priority, tags or dates, use search_tickets instead. Page contents can shift if tickets change while paging. Read-only: cannot modify tickets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "description": "Page number, 1-300",
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "per_page": {
            "default": 10,
            "description": "Tickets per page, 1-100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "requester_email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Only tickets raised by the contact with this email"
          },
          "requester_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Only tickets raised by this contact ID"
          },
          "company_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Only tickets from this company ID"
          },
          "updated_since": {
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "description": "Only tickets updated at or after this time: YYYY-MM-DD or ISO 8601 date-time with timezone"
          },
          "order_by": {
            "type": "string",
            "enum": [
              "created_at",
              "due_by",
              "updated_at",
              "status"
            ],
            "description": "Sort field (default created_at)"
          },
          "order_type": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Sort direction (default desc)"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tickets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "subject": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "description": "open | pending | resolved | closed, or \"custom (N)\" for account-specific statuses"
                },
                "priority": {
                  "type": "string",
                  "description": "low | medium | high | urgent"
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "description": "Channel the ticket came from, e.g. email, portal, phone, chat",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "requesterId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Contact ID of the customer; pass to get_contact for details"
                },
                "agentId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "ID of the assigned agent, if any"
                },
                "groupId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "companyId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dueBy": {
                  "description": "Resolution due time (ISO 8601 UTC)",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "subject",
                "status",
                "priority",
                "type",
                "source",
                "requesterId",
                "agentId",
                "groupId",
                "companyId",
                "tags",
                "dueBy",
                "createdAt",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "perPage": {
                "type": "integer",
